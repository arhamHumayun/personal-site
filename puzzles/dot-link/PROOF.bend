import Base
import ./dots.bend as Dots
import ./gen.bend as Gen
import ./LAWS.bend as Laws
import ../lemmas.bend as L

# The win
# -------

def Laws.solved_connects(w, h, pairs, sol, won):
  L.and_l(Dots.connects(w, h, pairs, sol), Dots.fills(w, h, sol), won)

def Laws.solved_fills(w, h, pairs, sol, won):
  L.and_r(Dots.connects(w, h, pairs, sol), Dots.fills(w, h, sol), won)

# The generator
# -------------
# Every Some the search holds was accepted and is regenerated by its seed.

def good(+i: Nat, m: Maybe<&2, Dots.Puzzle>) -> Type:
  match m:
    case None{}:
      Unit
    case Some{+p}:
      {Gen.accept(i, p) == True{} : Bool} & {Gen.puzzle(Gen.size(i), Dots.Puzzle.seed(p)) == p : Dots.Puzzle}

law keep_if_good:
  for +i: Nat
  for +sd: U32
  for b: Bool
  for hb: {Gen.accept(i, Gen.puzzle(Gen.size(i), sd)) == b : Bool}
  good(i, Gen.keep.if(Gen.puzzle(Gen.size(i), sd), b))

def keep_if_good(i, sd, b, hb):
  match b:
    case True{}:
      (hb, {==})
    case False{}:
      Unit{}

law tries_good:
  for k: Nat
  for +base: U32
  for +i: Nat
  for +a: U32
  for +m: Maybe<&2, Dots.Puzzle>
  for hm: good(i, m)
  good(i, Gen.tries(k, base, i, a, m))

def tries_good(k, base, i, a, m, hm):
  match k:
    case 0n:
      hm
    case 1n+f:
      match m:
        case Some{p}:
          hm
        case None{}:
          tries_good(f, base, i, (a + 1 : U32),
            Gen.keep(i, Gen.puzzle(Gen.size(i), Gen.seed(base, i, a))),
            keep_if_good(i, Gen.seed(base, i, a),
              Gen.accept(i, Gen.puzzle(Gen.size(i), Gen.seed(base, i, a))), {==}))

law good_at:
  for +i: Nat
  for +m: Maybe<&2, Dots.Puzzle>
  for +p: Dots.Puzzle
  for hm: good(i, m)
  for h: {m == Some{p} : Maybe<&2, Dots.Puzzle>}
  good(i, Some{p})

def good_at(i, m, p, hm, h):
  %h : good(i, _)
  hm

law emitted_good:
  for +base: U32
  for +i: Nat
  for +p: Dots.Puzzle
  for h: {Gen.level(base, i) == Some{p} : Maybe<&2, Dots.Puzzle>}
  good(i, Some{p})

def emitted_good(base, i, p, h):
  good_at(i, Gen.level(base, i), p, tries_good(1000n, base, i, 0, None{}, Unit{}), h)

law good_accepted:
  for +i: Nat
  for +p: Dots.Puzzle
  for hg: good(i, Some{p})
  {Gen.accept(i, p) == True{} : Bool}

def good_accepted(i, p, hg):
  (accepted, regen) = hg
  accepted

law good_regen:
  for +i: Nat
  for +p: Dots.Puzzle
  for hg: good(i, Some{p})
  {Gen.puzzle(Gen.size(i), Dots.Puzzle.seed(p)) == p : Dots.Puzzle}

def good_regen(i, p, hg):
  (accepted, regen) = hg
  regen

# What accept checked, one condition at a time
# --------------------------------------------

def range(+i: Nat, +g: Dots.Game) -> Bool:
  Bool.and(Nat.is_le(Gen.min_pairs(i), List.length(&2, Dots.Dots, Dots.Game.pairs(g))),
    Nat.is_le(List.length(&2, Dots.Dots, Dots.Game.pairs(g)), Gen.max_pairs(i)))

law acc:
  for +base: U32
  for +i: Nat
  for +p: Dots.Puzzle
  for h: {Gen.level(base, i) == Some{p} : Maybe<&2, Dots.Puzzle>}
  {Gen.accept(i, p) == True{} : Bool}

def acc(base, i, p, h):
  good_accepted(i, p, emitted_good(base, i, p, h))

law acc_size:
  for +base: U32
  for +i: Nat
  for +p: Dots.Puzzle
  for h: {Gen.level(base, i) == Some{p} : Maybe<&2, Dots.Puzzle>}
  {Gen.accept.size(i, Dots.Puzzle.game(p)) == True{} : Bool}

def acc_size(base, i, p, h):
  L.and_r(Nat.is_eq(Dots.Game.w(Dots.Puzzle.game(p)), Gen.size(i)),
    Gen.accept.size(i, Dots.Puzzle.game(p)), acc(base, i, p, h))

law acc_dots:
  for +base: U32
  for +i: Nat
  for +p: Dots.Puzzle
  for h: {Gen.level(base, i) == Some{p} : Maybe<&2, Dots.Puzzle>}
  {Gen.accept.dots(i, Dots.Puzzle.game(p)) == True{} : Bool}

def acc_dots(base, i, p, h):
  L.and_r(Nat.is_eq(Dots.Game.h(Dots.Puzzle.game(p)), Gen.size(i)),
    Gen.accept.dots(i, Dots.Puzzle.game(p)), acc_size(base, i, p, h))

law acc_apart:
  for +base: U32
  for +i: Nat
  for +p: Dots.Puzzle
  for h: {Gen.level(base, i) == Some{p} : Maybe<&2, Dots.Puzzle>}
  {Bool.and(Dots.apart(Dots.Game.pairs(Dots.Puzzle.game(p))),
    Gen.accept.lines(Dots.Puzzle.game(p))) == True{} : Bool}

def acc_apart(base, i, p, h):
  L.and_r(range(i, Dots.Puzzle.game(p)),
    Bool.and(Dots.apart(Dots.Game.pairs(Dots.Puzzle.game(p))),
      Gen.accept.lines(Dots.Puzzle.game(p))),
    acc_dots(base, i, p, h))

law acc_lines:
  for +base: U32
  for +i: Nat
  for +p: Dots.Puzzle
  for h: {Gen.level(base, i) == Some{p} : Maybe<&2, Dots.Puzzle>}
  {Gen.accept.lines(Dots.Puzzle.game(p)) == True{} : Bool}

def acc_lines(base, i, p, h):
  L.and_r(Dots.apart(Dots.Game.pairs(Dots.Puzzle.game(p))),
    Gen.accept.lines(Dots.Puzzle.game(p)), acc_apart(base, i, p, h))

# Laws
# ----

def Laws.emitted_solvable(base, i, p, h):
  L.and_r(Dots.thin(Dots.Game.sol(Dots.Puzzle.game(p))),
    Dots.solved(Dots.Game.w(Dots.Puzzle.game(p)), Dots.Game.h(Dots.Puzzle.game(p)),
      Dots.Game.pairs(Dots.Puzzle.game(p)), Dots.Game.sol(Dots.Puzzle.game(p))),
    acc_lines(base, i, p, h))

def Laws.emitted_lines_thin(base, i, p, h):
  L.and_l(Dots.thin(Dots.Game.sol(Dots.Puzzle.game(p))),
    Dots.solved(Dots.Game.w(Dots.Puzzle.game(p)), Dots.Game.h(Dots.Puzzle.game(p)),
      Dots.Game.pairs(Dots.Puzzle.game(p)), Dots.Game.sol(Dots.Puzzle.game(p))),
    acc_lines(base, i, p, h))

def Laws.emitted_dots_apart(base, i, p, h):
  L.and_l(Dots.apart(Dots.Game.pairs(Dots.Puzzle.game(p))),
    Gen.accept.lines(Dots.Puzzle.game(p)), acc_apart(base, i, p, h))

def Laws.emitted_width(base, i, p, h):
  L.eq_sound(Dots.Game.w(Dots.Puzzle.game(p)), Gen.size(i),
    L.and_l(Nat.is_eq(Dots.Game.w(Dots.Puzzle.game(p)), Gen.size(i)),
      Gen.accept.size(i, Dots.Puzzle.game(p)), acc(base, i, p, h)))

def Laws.emitted_height(base, i, p, h):
  L.eq_sound(Dots.Game.h(Dots.Puzzle.game(p)), Gen.size(i),
    L.and_l(Nat.is_eq(Dots.Game.h(Dots.Puzzle.game(p)), Gen.size(i)),
      Gen.accept.dots(i, Dots.Puzzle.game(p)), acc_size(base, i, p, h)))

def Laws.emitted_pairs_in_range(base, i, p, h):
  L.and_l(range(i, Dots.Puzzle.game(p)),
    Bool.and(Dots.apart(Dots.Game.pairs(Dots.Puzzle.game(p))),
      Gen.accept.lines(Dots.Puzzle.game(p))),
    acc_dots(base, i, p, h))

def Laws.same_seed_same_puzzle(n, seed):
  {==}

def Laws.emitted_seed_regenerates(base, i, p, h):
  good_regen(i, p, emitted_good(base, i, p, h))
